{
  "version": "8.25.8",
  "prettier": {
    "singleQuote": true,
    "printWidth": 120
  },
  "scripts": {
    "build": "docker build -t thoughtcore-node . ",
    "watch": "./node_modules/.bin/lerna run watch --parallel",
    "bootstrap": "./node_modules/.bin/lerna bootstrap",
    "insight:build": "cd ./packages/insight && npm i && npm run build",
    "node": "cd packages/thoughtcore-node && npm start",
    "tws": "cd packages/thoughtcore-wallet-service && npm start",
    "compile": "./node_modules/.bin/lerna run compile",
    "test:ci:local": "npm run test:ci:build:local && npm run test:ci:all",
    "test:ci:build:local": "./ci.sh build local",
    "test:ci:build": "./ci.sh build ci",
    "test:ci:all": "./ci.sh 'npm run lerna:ci:all'",
    "test:ci:unit": "./ci.sh 'npm run lerna:ci:unit'",
    "test:ci:integration": "./ci.sh 'npm run lerna:ci:integration'",
    "test:ci:coverage": "./ci.sh 'npm run lerna:ci:coverage'",
    "test:thoughtcore-wallet-service": "cd ./packages/thoughtcore-wallet-service && npm run test",
    "ci:thoughtcore-wallet-service": "./ci.sh 'npm run test:thoughtcore-wallet-service'",
    "test:thoughtcore-wallet-client": "cd ./packages/thoughtcore-wallet-client && npm run test",
    "ci:thoughtcore-wallet-client": "./ci.sh 'npm run test:thoughtcore-wallet-client'",
    "test:thoughtcore-wallet": "cd ./packages/thoughtcore-wallet && npm run test",
    "ci:thoughtcore-wallet": "./ci.sh 'npm run test:thoughtcore-wallet'",
    "test:crypto-wallet-core": "cd ./packages/crypto-wallet-core && npm run test",
    "ci:crypto-wallet-core": "./ci.sh 'npm run test:crypto-wallet-core'",
    "test:thoughtcore-node": "cd ./packages/thoughtcore-node && npm run test",
    "test:thoughtcore-node:coverage": "cd ./packages/thoughtcore-node && npm run coverage",
    "test:thoughtcore-node:int": "cd ./packages/thoughtcore-node && npm run test:integration",
    "ci:thoughtcore-node": "./ci.sh 'npm run test:thoughtcore-node'",
    "ci:thoughtcore-node:int": "./ci.sh 'npm run test:thoughtcore-node:int'",
    "ci:thoughtcore-node:coverage": "./ci.sh 'npm run test:thoughtcore-node:coverage'",
    "test:thoughtcore-lib": "cd ./packages/thoughtcore-lib && npm run test",
    "ci:thoughtcore-lib": "./ci.sh 'npm run test:thoughtcore-lib'",
    "test:thoughtcore-lib-cash": "cd ./packages/thoughtcore-lib-cash && npm run test",
    "ci:thoughtcore-lib-cash": "./ci.sh 'npm run test:thoughtcore-lib-cash'",
    "test:thoughtcore-lib-ltc": "cd ./packages/thoughtcore-lib-ltc && npm run test",
    "ci:thoughtcore-lib-ltc": "./ci.sh 'npm run test:thoughtcore-lib-ltc'",
    "test:thoughtcore-lib-doge": "cd ./packages/thoughtcore-lib-doge && npm run test",
    "ci:thoughtcore-lib-doge": "./ci.sh 'npm run test:thoughtcore-lib-doge'",
    "test:thoughtcore-p2p": "cd ./packages/thoughtcore-p2p && npm run test",
    "ci:thoughtcore-p2p": "./ci.sh 'npm run test:thoughtcore-p2p'",
    "test:thoughtcore-p2p-cash": "cd ./packages/thoughtcore-p2p-cash && npm run test",
    "ci:thoughtcore-p2p-cash": "./ci.sh 'npm run test:thoughtcore-p2p-cash'",
    "test:thoughtcore-p2p-doge": "cd ./packages/thoughtcore-p2p-doge && npm run test",
    "ci:thoughtcore-p2p-doge": "./ci.sh 'npm run test:thoughtcore-p2p-doge'",
    "test:thoughtcore-mnemonic": "cd ./packages/thoughtcore-mnemonic && npm run test",
    "ci:thoughtcore-mnemonic": "./ci.sh 'npm run test:thoughtcore-mnemonic'",
    "test:thoughtcore-client": "cd ./packages/thoughtcore-client && npm run test",
    "ci:thoughtcore-client": "./ci.sh 'npm run test:thoughtcore-client'",
    "lerna:ci:all": "npx lerna run test:ci --concurrency 1 --stream",
    "lerna:ci:unit": "npx run test:ci:unit --concurrency 1 --stream",
    "lerna:ci:integration": "npx run test:ci:integration --concurrency 1 --stream",
    "lerna:ci:coverage": "npx run coverage --concurrency 1 --stream"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "devDependencies": {
    "cz-customizable": "^7.2.1",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.1.5",
    "tslint": "^5.20.1",
    "tslint-config-prettier": "^1.18.0",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "typedoc": "^0.26.6",
    "typescript-eslint": "8.3.0"
  },
  "dependencies": {
    "@types/got": "9.6.12",
    "lerna": "^8.1.9",
    "typescript": "5.5.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run precommit"
    }
  },
  "name": "thoughtcore-monorepo",
  "workspaces": ["packages/*"]
}
