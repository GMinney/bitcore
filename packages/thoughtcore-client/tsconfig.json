{
  "compilerOptions": {
    "lib": [
      "dom",
      "es6",
      "es2017"
    ],
    "noImplicitAny": false,
    "removeComments": true,
    "declaration": true,
    "declarationMap": true,
    "module": "ESNext",
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "target": "ES6",
    // "typeRoots": [
    //   "./node_modules/@types"
    // ],
    "baseUrl": ".",
    "paths": {
      "*": [
        "*",
        "./src/*",
        "./test/*"
      ]
    },
    "outDir": "ts_build",
    "sourceMap": true
  },
  "include": [
    "./src/**/*.ts",
    "./test/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}