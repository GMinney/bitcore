{
  "compilerOptions": {
    "lib": [
      "dom",
      "es6",
      "es2017"
    ],
    "noImplicitAny": false,
    "removeComments": true,
    "declaration": true,
    "declarationMap": true,
    "module": "CommonJS",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "target": "ES6",
    // "types": [
    //   "node", "mocha"
    // ],
    "baseUrl": ".",
    "paths": {
      "*": [
        "*",
        "./src/*"
      ]
    },
    "outDir": "ts_build",
    "sourceMap": true
  },
  "include": [
    "./src/**/*.ts",
    "./test/**/*.ts",
    "src/index.ts"
  ]
}